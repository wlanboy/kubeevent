# Pfad zur SQLite-Datei, das Verzeichnis wird bei Bedarf angelegt
DB_PATH=data/events.db

# Kommagetrennte Liste der beobachteten Namespaces
WATCH_NAMESPACES=kubeevent,randomfail
# Früherer Name von WATCH_NAMESPACES, gilt nur, wenn WATCH_NAMESPACES leer ist
# POD_NAMESPACE=kubeevent,randomfail

# Events, die älter sind, löscht der stündliche Retention-Job
RETENTION_DAYS=7
# Metrik-Zeitreihen ohne neues Event in diesem Zeitraum verschwinden aus /metrics
METRICS_SERIES_TTL_HOURS=24

# Puffer zwischen Watchern und DB-Worker
QUEUE_MAXSIZE=10000
# Größe (max. 2000) und maximale Wartezeit in Sekunden eines Batches im DB-Worker
BATCH_MAX_SIZE=500
BATCH_MAX_DELAY=0.2

# Nach dieser Zeit beendet der API-Server einen Watch, der Watcher verbindet sich neu
WATCH_TIMEOUT_SECONDS=300

LOG_LEVEL=INFO

# Nur für den Start mit "uv run main.py"
HOST=0.0.0.0
PORT=8001
RELOAD=false
